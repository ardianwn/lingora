# Public client configuration only. Never put DeepSeek, STT, TTS, Supabase service-role,
# or any other provider secret in an EXPO_PUBLIC_* variable.
EXPO_PUBLIC_API_BASE_URL=http://localhost:3000
# Public Supabase client values only. Never add the service-role key here.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
